[Unit]
Description=JUST Advisor – FastAPI + Socket.IO Backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/justadvisor/backend
Environment=PYTHONPATH=/var/www/justadvisor/backend
EnvironmentFile=/var/www/justadvisor/backend/.env
# السطر الذهبي: تشغيل السوكت مع الـ Reload التلقائي لمنع الـ 502 للأبد
ExecStart=/var/www/justadvisor/backend/venv/bin/python3 -m uvicorn main:socket_app --host 127.0.0.1 --port 8080 --workers 1 --reload
StandardError=journal
SyslogIdentifier=justadvisor

[Install]
WantedBy=multi-user.target