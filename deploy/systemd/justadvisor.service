[Unit]
Description=JUST Advisor – FastAPI + Socket.IO
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/justadvisor/backend
EnvironmentFile=/var/www/justadvisor/backend/.env
ExecStart=/var/www/justadvisor/venv/bin/gunicorn \
    -c /var/www/justadvisor/deploy/gunicorn.conf.py \
    main:socket_app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=justadvisor

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
