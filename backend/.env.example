# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev (SQLite — default, no changes needed):
# DATABASE_URL=sqlite:///./Project.db
# Production (PostgreSQL):
DATABASE_URL=postgresql://justadvisor:CHANGE_ME@localhost:5432/justadvisor

# ─── Application ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ENVIRONMENT=production
# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=https://yourdomain.com

# ─── TURN Server (coturn — WebRTC NAT traversal) ──────────────────────────────
TURN_SERVER_IP=YOUR_DROPLET_IP
TURN_USERNAME=justadvisor
TURN_CREDENTIAL=CHANGE_ME_turn_password

# ─── AI / RAG Stack ───────────────────────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=CHANGE_ME_your_gemini_api_key

# Pinecone Vector DB — https://app.pinecone.io
PINECONE_API_KEY=CHANGE_ME_your_pinecone_api_key
# Name of the Pinecone index (create it before running seed_knowledge_base.py)
# Required settings when creating the index:
#   Dimension : 768   (gemini-embedding-001 with output_dimensionality=768)
#   Metric    : cosine
#   Type      : Serverless
PINECONE_INDEX_NAME=just-cs-advisor
